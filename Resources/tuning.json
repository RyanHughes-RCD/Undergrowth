  "creatureFinds": "egg",
  "eggs": {
    "_about": "creatureFinds 'egg': creature finds give eggs (Resources/Content/eggs.json); 'instant' gives the creature as before. Eggs hatch in nests (baseNests + Old Log nest unlocks) into a species of their family at or below their tier, chosen from the nest tile's stats at hatch time, weighted by find chance x sameTierBoost (the egg's tier) or tierBelowBoost (one below). The starter's guaranteed creature still comes straight away.",
    "baseNests": 1,
    "sameTierBoost": 8,
    "tierBelowBoost": 2
  },
