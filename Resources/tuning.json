      "base": 1,
      "generalByEffectCount": [1, 3, 5, 7],
      "perStatPoint": 0.05,
      "maxIntensityBonus": 3,
      "maxWeight": 24
    },
    "blankTileSpawnChance": 0.35,
    "terrainAffinity": {
      "_about": "What spawns on developed ground. Items with stat needs that are met get x byRarity, plus perExtraLevel for each intensity level the tile is above their need (averaged over their needs, up to extraLevelCap); beyond overshootGrace levels above their need they fade by overshootFadePerLevel per level, so rich ground favours the items made for it over low-need commons. Items with no needs fade by genericFadePerLevel per intensity level (down to genericMinFactor) on ground whose stats favour a different category.",
      "byRarity": { "common": 6, "uncommon": 12, "rare": 30, "veryRare": 80, "legendary": 250 },
      "perExtraLevel": 0.25,
      "extraLevelCap": 2,
      "overshootGrace": 2,
      "overshootFadePerLevel": 0.25,
      "genericFadePerLevel": 0.4,
      "genericMinFactor": 0.08
    },
