    "locationWeighting": {
      "_about": "Where spawns land. weight = base x generalByEffectCount[effects on the tile] x (1 + min(maxIntensityBonus, perStatPoint x stat total)), capped at maxWeight. Effects = creatures reaching the tile + soil boosts + special-effect areas + combos.",
